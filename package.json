{
  "name": "ArrExtension",
  "version": "1.0.0",
  "description": "ArrExtension - Chrome Extension for *arr applications",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "version:minor": "node bump-version.js minor",
    "version:major": "node bump-version.js major",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --headed",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smuzoka/arr-extension.git"
  },
  "keywords": [
    "chrome-extension",
    "arr",
    "sonarr",
    "radarr",
    "browser-extension"
  ],
  "author": "Sydney Muzoka",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/smuzoka/arr-extension/issues"
  },
  "homepage": "https://github.com/smuzoka/arr-extension#readme",
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/chrome": "^0.0.326",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@wxt-dev/module-react": "^1.1.3",
    "eslint": "^8.56.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.8.3",
    "vitest": "^1.5.0",
    "wxt": "^0.20.7"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}